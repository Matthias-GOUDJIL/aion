#!/bin/bash

# Aion Universal Compiler Wrapper
IMAGE_NAME="aion-compiler"

# Proactive cleanup of any stale containers before starting
docker ps -q --filter "ancestor=$IMAGE_NAME" | xargs -r docker stop > /dev/null 2>&1

# Build image if missing
if [[ "$(docker images -q $IMAGE_NAME 2> /dev/null)" == "" ]]; then
    echo "📦 Initializing Aion Environment..."
    docker build -t $IMAGE_NAME . > /dev/null
fi

# Run with isolated target directory inside container to avoid host locks
# Using /tmp/target inside container ensures clean build environment
docker run --rm -v "$(pwd)":/workspace -w /workspace \
    $IMAGE_NAME \
    cargo run --quiet --color never --target-dir /tmp/target -- "$@"
