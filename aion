#!/bin/bash

# Aion Universal Compiler Wrapper
IMAGE_NAME="aion-compiler"

# Proactive cleanup (disabled by default for speed, only run if image is missing)
# docker ps -q --filter "ancestor=$IMAGE_NAME" | xargs -r docker stop > /dev/null 2>&1

# Build image if missing
if [[ "$(docker images -q $IMAGE_NAME 2> /dev/null)" == "" ]]; then
    echo "📦 Initializing Aion Environment..."
    docker build -t $IMAGE_NAME . > /dev/null
fi

# Use Docker volumes for caching to avoid recompiling from scratch every time
# - aion-target-cache: caches target directory (Rust build artifacts)
# - aion-cargo-cache: caches cargo registry (dependencies)
docker run --rm \
    -v "$(pwd)":/workspace \
    -v aion-target-cache:/tmp/target \
    -v aion-cargo-cache:/root/.cargo/registry \
    -w /workspace \
    $IMAGE_NAME \
    cargo run --quiet --color never --target-dir /tmp/target -- "$@"
