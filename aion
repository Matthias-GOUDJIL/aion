#!/bin/bash

# Aion Universal Compiler Wrapper
# Ce script redirige les commandes vers l'environnement Docker sécurisé

IMAGE_NAME="aion-compiler"

# Vérifier si l'image existe, sinon la construire
if [[ "$(docker images -q $IMAGE_NAME 2> /dev/null)" == "" ]]; then
    echo "📦 Initialisation de l'environnement Aion (première exécution)..."
    docker build -t $IMAGE_NAME . > /dev/null
fi

# Exécuter la commande dans le conteneur en montant le dossier actuel
docker run --rm -v "$(pwd)":/workspace -w /workspace $IMAGE_NAME cargo run --quiet -- "$@"
