use std.collections.vector
use std.io

fn main() {
    io.println("Starting vector test...")
    let mut v = Vector<String>.new()
    io.println("Created vector")
    
    v.push("Hello")
    v.push("World")
    v.push("Aion")
    io.println("Pushed 3 elements")
    
    io.print("Vector len: ")
    io.println(v.len())

    let v0_opt = v.get(0)
    if v0_opt.is_some() {
        io.print("v[0] is Some: ")
        io.println(v0_opt.unwrap())
    } else {
        io.println("v[0] is None!")
    }
    
    let v1 = v.get(1)
    io.print("v[1]: ")
    io.println(v1.unwrap())
    
    let v2 = v.get(2)
    io.print("v[2]: ")
    io.println(v2.unwrap())
    
    if v.len() == 3 {
        io.println("Vector<String> len works")
    }
}
