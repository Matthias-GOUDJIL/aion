use std.collections.vector
use std.io

fn main() {
    io.println("Starting vector test...")
    let mut v = Vector<String>.new()
    io.println("Created vector")
    
    v.push("Hello")
    v.push("World")
    v.push("Aion")
    io.println("Pushed 3 elements")

    let v0 = v.get(0)
    io.println(v0.unwrap())
    
    let v1 = v.get(1)
    io.println(v1.unwrap())
    
    let v2 = v.get(2)
    io.println(v2.unwrap())
    
    if v.len() == 3 {
        io.println("Vector<String> len works")
    }
}
