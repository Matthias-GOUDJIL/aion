        "tests/fixtures/compiler/self_parser_stmts.ai",
        "tests/fixtures/compiler/self_parser_suite.ai",
    ]
    let total = @sizeof([String; 136]) / 8
    let mut i = 0
    let mut failed = 0
    while i < total {
        let src_res = fs.read_to_string(paths[i])
        if src_res.is_err() {
            io.print("FAIL(read): ")
            io.println(paths[i])
            failed = failed + 1
            i = i + 1
            continue
        }
        let src = src_res.unwrap()
        let r = parse_source(src, paths[i])
        failed = failed + r
        i = i + 1
    }
    io.print("parsed ")
    io.print(string.from_int(total - failed))
    io.print("/")
    io.print(string.from_int(total))
    io.println(" fixtures")
    return 0
}
