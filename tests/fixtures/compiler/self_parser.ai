use std.io
use std.string
use std.collections.vector
use compiler.lexer
use compiler.parser
use compiler.ast
use compiler.token

fn main() {
    io.println("--- Starting Self-Hosted Parser ---")
    let source = "fn add(a: i64, b: i64) -> i64 { let result = a + b; return result; }"
    
    let mut lex = lexer.Lexer_new(source)
    let mut tokens = vector.Vector<token.Token>.new()
    
    io.println("Tokenizing...")
    let mut done = false
    while !done {
        let tok = lex.next_token()
        tokens.push(tok)
        match tok.kind {
            token.TokenKind::EOF => { done = true; },
            _ => { }
        }
    }
    
    let mut j = 0
    while j < tokens.len() {
        let t = tokens.get(j).unwrap() as token.Token
        match t.kind {
            token.TokenKind::Identifier(v) => { io.print("ID:"); io.println(v) },
            token.TokenKind::Fn => { io.println("Fn") },
            token.TokenKind::LParen => { io.println("LParen") },
            token.TokenKind::RParen => { io.println("RParen") },
            _ => { io.println("Other") }
        }
        j = j + 1
    }
    
    io.print("Tokens: ")
    io.println(string.from_int(tokens.len()))
    
    io.println("Initializing Parser...")
    let mut p = parser.Parser.new(tokens)
    
    io.println("Parsing Program...")
    let prog_res = p.parse_program()
    
    if prog_res.is_err() {
        io.print("Parser Error: ")
        io.println(prog_res.unwrap_err() as String)
        return
    }
    
    io.println("Program Parsed Successfully!")
    let prog = prog_res.unwrap() as ast.Program
    let decls = prog.declarations
    
    io.print("Parsed ")
    io.print(string.from_int((decls).len()))
    io.println(" declarations.")
    
    let mut i = 0
    while i < (decls).len() {
        let decl_opt = (decls).get(i)
        let decl = decl_opt.unwrap() as ast.Declaration
        
        match decl {
            ast.Declaration::Function(f) => {
                io.print("Function: ")
                io.println(f.name)
                io.print("  Return Type: ")
                io.println(f.return_type)
                
                let body = f.body
                io.print("  Statements: ")
                io.println(string.from_int((body).len()))
            },
            _ => {
                io.println("Other declaration")
            }
        }
        
        i = i + 1
    }
    io.println("--- Success ---")
}
