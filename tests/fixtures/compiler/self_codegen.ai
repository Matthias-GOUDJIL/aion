use std.io
use std.fs
use std.string
use std.collections.vector
use compiler.lexer
use compiler.parser
use compiler.ast
use compiler.codegen

// #135 — the Ouroboros pipeline fixture: the self-hosted front end
// (compiler/lexer.ai + compiler/parser.ai) feeds compiler/codegen.ai,
// which emits the LLVM IR for a NON-TRIVIAL program (structs, member
// access, while loops, match with String phi, generic monomorphization,
// f-strings, intrinsics with deref stores).
//
// Writes two files consumed by the parity integration test
// (tests/integration.rs::test_self_codegen_parity):
//   - tests/tmp/parity_src.ai   — the embedded source (for the Rust path)
//   - tests/tmp/parity_aion.ll  — the Aion-backend-generated `.ll`
//
// Acceptance (per #135):
//   - self_codegen.ai compiles via codegen.ai                    [x]
//   - Generated `.ll` passes `opt-15 --opaque-pointers -verify`  (test)
//   - Aion-backend binary stdout == Rust-backend binary stdout   (test)

fn main() {
    let source = "struct Pair {
    a: i64,
    b: i64,
}

fn add_all(n: i64) -> i64 {
    let mut sum = 0
    let mut i = 0
    while i < n {
        sum = sum + i
        i = i + 1
    }
    return sum
}

fn describe(x: i64) -> String {
    return match x {
        0 => \"zero\",
        _ => \"many\",
    }
}

fn id<T>(x: T) -> T {
    return x
}

fn main() {
    let p = Pair { a: 3, b: 4 }
    io.println(string.from_int(p.a + p.b))
    io.println(string.from_int(add_all(5)))
    io.println(describe(0))
    io.println(f\"count={string.from_int(id<i64>(2))}\")
    let buf = unsafe { @intrinsic(\"malloc\", 16) }
    let p2 = buf as *i64
    unsafe { @intrinsic(\"mem_zero_ptr\", p2 as *u8, 16) }
    unsafe { *p2 = 42 }
    io.println(string.from_int(unsafe { *p2 }))
    return 0
}"

    // Persist the source for the Rust-side parity build.
    let w1 = std.fs.write("tests/tmp/parity_src.ai", source)
    io.print("src written: ")
    io.println(string.from_int(w1))

    // Self-hosted pipeline: lex → parse → codegen.
    let mut lex = compiler.lexer.Lexer_new(source)
    let mut tokens = vector.Vector<token.Token>.new()
    let mut done = false
    while !done {
        let tok = lex.next_token()
        let is_eof = match tok.kind {
            compiler.token.TokenKind::EOF => true,
            _ => false,
        }
        tokens.push(tok)
        if is_eof { done = true }
    }

    let mut p = compiler.parser.Parser.new(tokens)
    let prog_res = p.parse_program()
    if prog_res.is_err() {
        io.print("parser error: ")
        io.println(prog_res.unwrap_err() as String)
        return
    }
    let prog = prog_res.unwrap() as compiler.ast.Program

    let mut cg = compiler.codegen.Codegen.new("parity_module")
    let ir = cg.compile(prog)

    // Persist the generated `.ll` for the parity test.
    let w2 = std.fs.write("tests/tmp/parity_aion.ll", ir)
    io.print("ll written: ")
    io.println(string.from_int(w2))
}
