::intent "SQL transpiler: unsupported constructs are reported with spans (#74)"

enum Shape {
    Circle(i64),
    Square(i64),
}

fn use_spawn() {
    spawn {
        let x = 1
    }
}

fn use_array() -> i64 {
    let arr = [1, 2, 3]
    return arr[0]
}

fn use_payload(s: Shape) -> i64 {
    match s {
        Circle(r) => r,
        Square(w) => w,
    }
}

fn use_tuple() -> i64 {
    let (a, b) = compute_pair()
    return a
}

fn compute_pair() -> i64 {
    return 2
}

fn use_fs() -> i64 {
    return fs_write("log.txt", "hello")
}
