struct Point { x: i64, y: i64 }

fn main() {
    let p = Point { x: 1, y: 2 }
    
    // Nested braces: struct literal inside f-string interpolation
    let x_str = string.from_int(p.x)
    let y_str = string.from_int(p.y)
    let desc = f"Point({x_str}, {y_str})"
    io.println(desc)
    
    return 0
}
