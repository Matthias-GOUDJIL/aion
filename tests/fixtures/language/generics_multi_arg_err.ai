fn make<K, V>(k: K) -> K { return k }

// Unterminated generic-args list (no closing `>` before end of expression):
// is_generic_args_ahead aborts on EOF/Semicolon and treats `<` as less-than,
// so the stray comma surfaces as a syntax error (#182 — reported at the
// offending token instead of being swallowed into a confusing checker error).
fn main() {
    let z = make<i64,
    return 0
}
