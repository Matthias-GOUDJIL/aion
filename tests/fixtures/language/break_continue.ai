fn main() {
    let mut i = 0
    while i < 10 {
        if i == 5 {
            break
        }
        i = i + 1
    }
    io.println(string.from_int(i))

    let mut sum = 0
    let mut j = 0
    while j < 10 {
        j = j + 1
        if j % 2 == 0 {
            continue
        }
        sum = sum + j
    }
    io.println(string.from_int(sum))

    let mut count = 0
    while true {
        count = count + 1
        if count == 100 {
            break
        }
    }
    io.println(string.from_int(count))

    io.println("all break/continue tests done")
    return 0
}
