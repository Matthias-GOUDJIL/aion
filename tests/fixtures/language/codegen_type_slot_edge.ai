use std.io

struct Holder<T> {
    item: T,
    tag: i64,
}

fn apply_pair(f: fn(i64, i64) -> i64, p: (i64, i64)) -> i64 {
    return f(p.0, p.1)
}

fn sum_two(a: i64, b: i64) -> i64 {
    return a + b
}

fn main() {
    // 1. Nominal + edge: tuple of (array of tuples, String)
    let a = ([(10, 20), (30, 40)], "ok")
    io.println(f"a.0[0].0: {(a.0)[0].0}")
    io.println(f"a.0[0].1: {(a.0)[0].1}")
    io.println(f"a.0[1].0: {(a.0)[1].0}")
    io.println(f"a.0[1].1: {(a.0)[1].1}")
    io.println(f"a.1: {a.1}")

    // 2. Destructuring + mutating an array of tuples
    let (arr, label) = a
    io.println(f"destructured label: {label}")
    io.println(f"arr[0].0 before: {arr[0].0}")
    arr[0] = (99, 100)
    io.println(f"arr[0].0 after: {arr[0].0}")
    io.println(f"arr[0].1 after: {arr[0].1}")

    // 3. Generic struct holding a nested tuple
    let h: Holder<(i64, String)> = Holder {
        item: (777, "nested"),
        tag: 42,
    }
    io.println(f"h.item.0: {(h.item).0}")
    io.println(f"h.item.1: {(h.item).1}")
    io.println(f"h.tag: {h.tag}")

    // 4. Function pointer in a variable slot invoked on a tuple element from an array
    let fp: fn(i64, i64) -> i64 = sum_two
    let s0 = apply_pair(fp, arr[0])
    let s1 = apply_pair(fp, arr[1])
    io.println(f"sum arr[0]: {s0}")
    io.println(f"sum arr[1]: {s1}")
}
