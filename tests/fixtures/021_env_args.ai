use std.env
use std.io
use std.string

fn main() {
    let arguments = env.args()
    io.print("Args count: ")
    io.println(string.from_int(arguments.len()))
    
    let mut i = 0
    while i < arguments.len() {
        io.print("Arg ")
        io.print(string.from_int(i))
        io.print(": ")
        io.println(arguments.get(i).unwrap())
        i = i + 1
    }
}
