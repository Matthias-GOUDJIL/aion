use std.env
use std.io
use std.string

fn main() {
    let arguments = env.args()
    io.println("Arg count received")
    
    // In our new env.args(), the first element is what was argv[1]
    // because we start i at 1 in env.ai. 
    // Wait, usually args[0] is the program name.
    
    // Let's check how many we have
    io.print("Count: ")
    io.println(string.from_int(arguments.len()))
}
