-- Generated by aionc — Aion to PostgreSQL transpiler.

CREATE OR REPLACE FUNCTION "test_declare"()
RETURNS BIGINT
AS $$
DECLARE
    "x" BIGINT;
    "y" BIGINT;
BEGIN
    "x" := 42;
    "y" := 100;
    RETURN ("x" + "y");
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "test_while"()
RETURNS BIGINT
AS $$
DECLARE
    "i" BIGINT;
    "sum" BIGINT;
BEGIN
    "i" := 0;
    "sum" := 0;
    WHILE ("i" < 3) LOOP
        "sum" := ("sum" + "i");
        "i" := ("i" + 1);
    END LOOP;
    RETURN "sum";
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "main"()
RETURNS VOID
AS $$
DECLARE
    "result" BIGINT;
    "w" BIGINT;
    "a" BOOLEAN;
    "b" BOOLEAN;
    "c" BOOLEAN;
    "d" BOOLEAN;
BEGIN
    RAISE NOTICE '%', 'SQL transpiler: DECLARE, WHILE, strings, AND/OR';
    "result" := "test_declare"();
    IF ("result" = 142) THEN
        RAISE NOTICE '%', 'DECLARE works';
    END IF;
    "w" := "test_while"();
    IF ("w" = 3) THEN
        RAISE NOTICE '%', 'WHILE works';
    END IF;
    "a" := TRUE;
    "b" := TRUE;
    IF ("a" AND "b") THEN
        RAISE NOTICE '%', 'AND works';
    END IF;
    "c" := FALSE;
    "d" := TRUE;
    IF ("c" OR "d") THEN
        RAISE NOTICE '%', 'OR works';
    END IF;
    RAISE NOTICE '%', 'Hello SQL World';
END;
$$ LANGUAGE plpgsql;
