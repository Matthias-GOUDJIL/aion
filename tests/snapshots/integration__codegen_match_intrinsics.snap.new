  br i1 %t0, label %match.arm.1, label %match.next.1
match.arm.1:
  br label %match.exit.0
match.next.1:
  %t1 = icmp eq i64 %c, 1
  br i1 %t1, label %match.arm.2, label %match.next.2
match.arm.2:
  br label %match.exit.0
match.next.2:
  br label %match.arm.3
match.arm.3:
  br label %match.exit.0
match.exit.0:
  %t2 = phi ptr [ @.str.0, %match.arm.1 ], [ @.str.1, %match.arm.2 ], [ @.str.2, %match.arm.3 ]
  ret ptr %t2
}

define i64 @unwrap2(ptr %m) {
entry:
  %t3 = getelementptr %Maybe, ptr %m, i32 0, i32 0
  %t4 = load i64, ptr %t3
  %t5 = icmp eq i64 %t4, 0
  br i1 %t5, label %match.arm.5, label %match.next.5
match.arm.5:
  %t6 = getelementptr i8, ptr %m, i64 8
  %t7 = load i64, ptr %t6
  %v.addr = alloca i64
  store i64 %t7, ptr %v.addr
  %t8 = load i64, ptr %v.addr
  br label %match.exit.4
match.next.5:
