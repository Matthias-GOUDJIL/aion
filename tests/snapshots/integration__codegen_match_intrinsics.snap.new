  br i1 %t9, label %match.arm.6, label %match.exit.4
match.arm.6:
  br label %match.exit.4
match.exit.4:
  %t10 = phi i64 [ %t8, %match.arm.5 ], [ 0, %match.arm.6 ], [ 0, %match.next.5 ]
  ret i64 %t10
}

define i32 @main() {
entry:
  %c.addr = alloca i64
  store i64 1, ptr %c.addr
  %t11 = load i64, ptr %c.addr
  %t12 = icmp eq i64 %t11, 0
  br i1 %t12, label %match.arm.8, label %match.next.8
match.arm.8:
  br label %match.exit.7
match.next.8:
