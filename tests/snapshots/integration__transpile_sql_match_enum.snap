-- Generated by aionc — Aion to PostgreSQL transpiler.

CREATE TYPE "Color" AS ENUM ('Red', 'Green', 'Blue');

CREATE TYPE "Point" AS (x BIGINT, y BIGINT);


CREATE OR REPLACE FUNCTION "announce"("c" "Color")
RETURNS VOID
AS $$
BEGIN
    CASE
        WHEN "c" = 'Red' THEN
            RAISE NOTICE '%', 'warm';
        WHEN "c" = 'Green' THEN
            RAISE NOTICE '%', 'fresh';
        WHEN "c" = 'Blue' THEN
            RAISE NOTICE '%', 'cool';
    END CASE;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "describe"("c" "Color")
RETURNS TEXT
AS $$
BEGIN
    RETURN CASE WHEN "c" = 'Red' THEN 'warm' WHEN "c" = 'Green' THEN 'fresh' WHEN "c" = 'Blue' THEN 'cool' END;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "score"("c" "Color")
RETURNS BIGINT
AS $$
DECLARE
    "base" BIGINT;
    "bonus" BIGINT;
BEGIN
    "base" := 10;
    "bonus" := CASE WHEN "c" = 'Red' THEN 5 WHEN "c" = 'Green' THEN 10 WHEN "c" = 'Blue' THEN 15 END;
    RETURN ("base" + "bonus");
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "word"("n" BIGINT)
RETURNS TEXT
AS $$
BEGIN
    RETURN CASE WHEN "n" = 0 THEN 'zero' WHEN ("n" >= 1 AND "n" <= 9) THEN 'small' WHEN "n" = 10 OR "n" = 20 THEN 'round' ELSE 'big' END;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "grade"("n" BIGINT)
RETURNS TEXT
AS $$
BEGIN
    RETURN CASE WHEN (TRUE) AND (("n" >= 90)) THEN 'high' WHEN (TRUE) AND (("n" >= 50)) THEN 'mid' ELSE 'low' END;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "clamp"("n" BIGINT, "lo" BIGINT, "hi" BIGINT)
RETURNS BIGINT
AS $$
BEGIN
    IF ("n" < "lo") THEN
        RETURN "lo";
    ELSE
        IF ("n" > "hi") THEN
            RETURN "hi";
        END IF;
    END IF;
    RETURN "n";
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "sum_to"("limit" BIGINT)
RETURNS BIGINT
AS $$
DECLARE
    "total" BIGINT;
    "i" BIGINT;
BEGIN
    "total" := 0;
    "i" := 0;
    WHILE ("i" <= "limit") LOOP
        "total" := ("total" + "i");
        "i" := ("i" + 1);
    END LOOP;
    RETURN "total";
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "first_past"("n" BIGINT, "limit" BIGINT)
RETURNS BIGINT
AS $$
DECLARE
    "i" BIGINT;
BEGIN
    "i" := 0;
    WHILE TRUE LOOP
        IF ("i" > "n") THEN
            EXIT;
        END IF;
        IF ("i" < 3) THEN
            "i" := ("i" + 1);
            CONTINUE;
        END IF;
        IF ("i" > "limit") THEN
            RETURN "i";
        END IF;
        "i" := ("i" + 1);
    END LOOP;
    RETURN "i";
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "make_point"("x" BIGINT, "y" BIGINT)
RETURNS "Point"
AS $$
BEGIN
    RETURN ROW("x", "y")::"Point";
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "translate"("p" "Point", "dx" BIGINT, "dy" BIGINT)
RETURNS "Point"
AS $$
BEGIN
    RETURN ROW(("p"."x" + "dx"), ("p"."y" + "dy"))::"Point";
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "main"()
RETURNS VOID
AS $$
DECLARE
    "c" "Color";
    "s" BIGINT;
    "p" "Point";
    "q" "Point";
    "tick" INTERVAL;
    "when" TIMESTAMP;
BEGIN
    "c" := 'Green';
    PERFORM "announce"("c");
    RAISE NOTICE '%', "describe"("c");
    "s" := "score"("c");
    RAISE NOTICE '%', CAST("s" AS TEXT);
    RAISE NOTICE '%', "word"(15);
    RAISE NOTICE '%', "grade"(75);
    RAISE NOTICE '%', CAST("clamp"(42, 0, 10) AS TEXT);
    RAISE NOTICE '%', CAST("sum_to"(4) AS TEXT);
    RAISE NOTICE '%', CAST("first_past"(10, 5) AS TEXT);
    "p" := "make_point"(3, 4);
    "q" := "translate"("p", 10, 20);
    RAISE NOTICE '%', CAST("q"."x" AS TEXT);
    RAISE NOTICE '%', CAST("q"."y" AS TEXT);
    "tick" := INTERVAL '5 seconds';
    "when" := '2024-01-01'::timestamp;
    IF ("tick" > INTERVAL '1 seconds') THEN
        RAISE NOTICE '%', 'done';
    END IF;
END;
$$ LANGUAGE plpgsql;
