-- Generated by aionc — Aion to PostgreSQL transpiler.

CREATE OR REPLACE FUNCTION "area"("w" DOUBLE PRECISION, "h" DOUBLE PRECISION)
RETURNS DOUBLE PRECISION
AS $$
BEGIN
    RETURN ("w" * "h");
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "escape_demo"()
RETURNS TEXT
AS $$
BEGIN
    RETURN 'It''s a "quoted" test';
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "concat_demo"("name" TEXT, "count" BIGINT)
RETURNS TEXT
AS $$
BEGIN
    RETURN ((("name" || ' has ') || "count") || ' items');
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "durations"()
RETURNS INTERVAL
AS $$
DECLARE
    "five" INTERVAL;
    "half" INTERVAL;
BEGIN
    "five" := INTERVAL '5 seconds';
    "half" := INTERVAL '500 milliseconds';
    IF ("half" < "five") THEN
        RETURN "five";
    END IF;
    RETURN "half";
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "dates"()
RETURNS TIMESTAMP
AS $$
DECLARE
    "start" TIMESTAMP;
    "end" TIMESTAMP;
BEGIN
    "start" := '2024-01-01'::timestamp;
    "end" := '2025-06-30'::timestamp;
    RETURN "start";
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "integer_ops"("a" BIGINT, "b" BIGINT)
RETURNS BIGINT
AS $$
DECLARE
    "rem" BIGINT;
    "xored" BIGINT;
    "bounded" BIGINT;
BEGIN
    "rem" := ("a" % "b");
    "xored" := ("a" # "b");
    "bounded" := CASE WHEN ("a" >= 0 AND "a" < 100) THEN "a" ELSE 0 END;
    RETURN (("rem" + "xored") + "bounded");
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "f64_to_i64"("v" DOUBLE PRECISION)
RETURNS BIGINT
AS $$
DECLARE
    "n" BIGINT;
BEGIN
    "n" := trunc("v")::BIGINT;
    RETURN "n";
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "i64_to_f64"("n" BIGINT)
RETURNS DOUBLE PRECISION
AS $$
DECLARE
    "v" DOUBLE PRECISION;
BEGIN
    "v" := ("n")::DOUBLE PRECISION;
    RETURN "v";
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "char_demo"("c" BIGINT)
RETURNS TEXT
AS $$
BEGIN
    RETURN chr(65);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "string_tools"("s" TEXT)
RETURNS BIGINT
AS $$
DECLARE
    "n" BIGINT;
    "slice" TEXT;
    "code" BIGINT;
BEGIN
    "n" := length("s");
    "slice" := substr("s", 0 + 1, 3);
    "code" := ascii(substr("s", 0 + 1, 1));
    RAISE NOTICE '%', "slice";
    RETURN ("n" + "code");
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "numeric_tools"("a" BIGINT, "b" BIGINT)
RETURNS BIGINT
AS $$
DECLARE
    "biggest" BIGINT;
    "smallest" BIGINT;
    "magnitude" BIGINT;
BEGIN
    "biggest" := GREATEST("a", "b");
    "smallest" := LEAST("a", "b");
    "magnitude" := abs("a");
    RETURN (("biggest" + "smallest") + "magnitude");
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "bool_logic"("a" BOOLEAN, "b" BOOLEAN)
RETURNS BOOLEAN
AS $$
BEGIN
    RETURN ("a" AND "b");
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION "main"()
RETURNS VOID
AS $$
DECLARE
    "price" DOUBLE PRECISION;
    "qty" DOUBLE PRECISION;
BEGIN
    RAISE NOTICE '%', 'types demo';
    "price" := 12.5;
    "qty" := 2.0;
    RAISE NOTICE '%', CAST("area"("price", "qty") AS TEXT);
    RAISE NOTICE '%', "escape_demo"();
    RAISE NOTICE '%', "concat_demo"('cart', 3);
    RAISE NOTICE '%', CAST("f64_to_i64"(9.75) AS TEXT);
    RAISE NOTICE '%', CAST("i64_to_f64"(7) AS TEXT);
    RAISE NOTICE '%', CAST("string_tools"('aion') AS TEXT);
    RAISE NOTICE '%', CAST("numeric_tools"(-5, 10) AS TEXT);
    RAISE NOTICE '%', "char_demo"(65);
END;
$$ LANGUAGE plpgsql;
