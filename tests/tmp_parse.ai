use std.io
use std.string
use std.collections.vector
use compiler.lexer
use compiler.parser
use compiler.ast
use compiler.token

fn main() {
    io.println("Main Start")
    let source = "fn add() {}"
    let mut lex = lexer.Lexer_new(source)
    io.println("Lexer initialized")
    let mut tokens = vector.Vector<token.Token>.new()
    io.println("Tokens vector initialized")
    let mut done = false
    let mut j = 0
    while !done {
        let tok = lex.next_token()
        io.print("Lexed token at "); io.println(string.from_int(tok as i64))
        tokens.push(tok)
        let saved_tok = tokens.get(j).unwrap() as token.Token
        io.print("Saved token at "); io.println(string.from_int(saved_tok as i64))
        match tok.kind { token.TokenKind::EOF => { done = true; }, _ => { } }
        j = j + 1
    }
    io.println("Lexing done")
    io.print("Tokens len: ")
    io.println(string.from_int(tokens.len()))
    io.print("Token 2: ")
    let t2 = tokens.get(2).unwrap() as token.Token
    io.println(string.from_int(t2 as i64))
    
    let mut p = parser.Parser.new(tokens)
    io.println("Parser initialized")
    let prog_res = p.parse_program()
    io.println("Parsing done")
    if prog_res.is_err() { io.println("Err") return }
    io.println("OK")
}