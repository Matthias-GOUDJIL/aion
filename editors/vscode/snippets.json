{
    "Function": {
        "prefix": "fn",
        "body": [
            "fn ${1:name}(${2:params}) -> ${3:i64} {",
            "    ${0}",
            "}"
        ],
        "description": "Define a function"
    },
    "Main Function": {
        "prefix": "main",
        "body": [
            "fn main() {",
            "    ${0}",
            "    return 0",
            "}"
        ],
        "description": "Define the main function"
    },
    "Let binding": {
        "prefix": "let",
        "body": [
            "let ${1:name} = ${2:value}"
        ],
        "description": "Declare a variable"
    },
    "Mut binding": {
        "prefix": "mut",
        "body": [
            "let mut ${1:name} = ${2:value}"
        ],
        "description": "Declare a mutable variable"
    },
    "Struct": {
        "prefix": "struct",
        "body": [
            "struct ${1:Name} {",
            "    ${2:field}: ${3:Type},",
            "    ${0}",
            "}"
        ],
        "description": "Define a struct"
    },
    "Enum": {
        "prefix": "enum",
        "body": [
            "enum ${1:Name} {",
            "    ${2:Variant}(${3:Type}),",
            "    ${0}",
            "}"
        ],
        "description": "Define an enum"
    },
    "Match": {
        "prefix": "match",
        "body": [
            "match ${1:expr} {",
            "    ${2:Variant}(${3:val}) => ${4:block},",
            "    ${0}",
            "}"
        ],
        "description": "Match expression"
    },
    "If": {
        "prefix": "if",
        "body": [
            "if ${1:condition} {",
            "    ${0}",
            "}"
        ],
        "description": "If block"
    },
    "If Else": {
        "prefix": "ifelse",
        "body": [
            "if ${1:condition} {",
            "    ${2}",
            "} else {",
            "    ${0}",
            "}"
        ],
        "description": "If-else block"
    },
    "Println": {
        "prefix": "pl",
        "body": [
            "io.println("${1:message}")"
        ],
        "description": "Print a message"
    },
    "Spawn": {
        "prefix": "spawn",
        "body": [
            "spawn {",
            "    ${0}",
            "}"
        ],
        "description": "Spawn a new thread"
    },
    "Intent": {
        "prefix": "intent",
        "body": [
            "::intent "${1:Goal}""
        ],
        "description": "Define an AI intent"
    }
}
