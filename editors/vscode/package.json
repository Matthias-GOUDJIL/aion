{
    "name": "aion-lang",
    "displayName": "Aion Language Support",
    "description": "Syntax highlighting and snippets for the Aion programming language",
    "version": "0.2.0",
    "engines": { "vscode": "^1.60.0" },
    "categories": [ "Programming Languages", "Snippets" ],
    "contributes": {
        "languages": [{
            "id": "aion",
            "aliases": ["Aion", "aion"],
            "extensions": [".ai"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "aion",
            "scopeName": "source.ai",
            "path": "./syntaxes/aion.tmLanguage.json"
        }],
        "snippets": [{
            "language": "aion",
            "path": "./snippets.json"
        }]
    }
}