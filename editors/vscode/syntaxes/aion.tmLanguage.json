{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Aion",
    "scopeName": "source.ai",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#fstrings" },
        { "include": "#keywords" },
        { "include": "#ai-native" },
        { "include": "#attributes" },
        { "include": "#constants" },
        { "include": "#operators" },
        { "include": "#types" },
        { "include": "#functions" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.aion",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.aion",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.aion",
                    "match": "\\b(if|else|match|return|for|in|use|pub|async|unsafe|require|extern|spawn|while|as)\\b"
                },
                {
                    "name": "keyword.declaration.aion",
                    "match": "\\b(fn|let|mut|struct|enum|interface|impl|channel|type|self)\\b"
                }
            ]
        },
        "ai-native": {
            "patterns": [
                {
                    "name": "keyword.other.intent.aion",
                    "match": "\\b(intent|invariant|inside)\\b"
                }
            ]
        },
        "attributes": {
            "patterns": [{
                "name": "entity.name.tag.aion",
                "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
            }]
        },
        "strings": {
            "name": "string.quoted.double.aion",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.aion",
                    "match": "\\\\."
                }
            ]
        },
        "fstrings": {
            "name": "string.quoted.double.fstring.aion",
            "begin": "f\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.aion",
                    "match": "\\\\."
                },
                {
                    "name": "variable.interpolation.aion",
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [
                        { "include": "$self" }
                    ]
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.numeric.date.aion",
                    "match": "\\bD[0-9]{4}-[0-9]{2}-[0-9]{2}\\b"
                },
                {
                    "name": "constant.numeric.duration.aion",
                    "match": "\\b[0-9]+(ms|s|m|h|d|y)\\b"
                },
                {
                    "name": "constant.numeric.float.aion",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.aion",
                    "match": "\\b[0-9]+\\b"
                },
                {
                    "name": "constant.language.boolean.aion",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.option.aion",
                    "match": "\\b(Some|None|Ok|Err)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.aion",
                    "match": "="
                },
                {
                    "name": "keyword.operator.comparison.aion",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.logical.aion",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.arithmetic.aion",
                    "match": "\\+|\\-|\\*|/|%|\\^"
                },
                {
                    "name": "keyword.operator.pipeline.aion",
                    "match": "\\|>"
                },
                {
                    "name": "keyword.operator.arrow.aion",
                    "match": "->|<-"
                },
                {
                    "name": "keyword.operator.namespace.aion",
                    "match": "::|\\."
                },
                {
                    "name": "keyword.operator.range.aion",
                    "match": "\\.\\."
                },
                {
                    "name": "keyword.operator.attribute.aion",
                    "match": "@"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.aion",
                    "match": "\\b(i64|f64|u8|u16|u32|u64|bool|char|String|void|Unit)\\b"
                },
                {
                    "name": "storage.type.generic.aion",
                    "match": "\\b[A-Z][a-zA-Z0-9]*\\b"
                },
                {
                    "name": "keyword.operator.optional.aion",
                    "match": "\\?"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.aion",
                    "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*\\()"
                }
            ]
        }
    }
}