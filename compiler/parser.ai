module compiler.parser

use std.collections.vector
use std.option
use std.result
use std.string
use compiler.token
use compiler.ast

pub struct Parser {
    tokens: vector.Vector<token.Token>,
    current: i64,
}

impl Parser {
    pub fn new(tokens: vector.Vector<token.Token>) -> Parser {
        Parser {
            tokens: tokens,
            current: 0,
        }
    }

    pub fn is_at_end(self) -> bool {
        let tk = self.peek();
        match tk.kind {
            token.TokenKind::EOF => true,
            _ => false,
        }
    }

    pub fn peek(self) -> token.Token {
        if self.current >= self.tokens.len() {
            return token.Token::new(token.TokenKind::EOF, 0, 0);
        }
        let opt_token = self.tokens.get(self.current);
        return opt_token.unwrap();
    }

    pub fn previous(self) -> token.Token {
        if self.current == 0 {
            return self.tokens.get(0).unwrap();
        }
        return self.tokens.get(self.current - 1).unwrap();
    }

    pub fn advance(mut self) -> token.Token {
        if !self.is_at_end() {
            self.current = self.current + 1;
        }
        return self.previous();
    }

    pub fn get_precedence(self, kind: token.TokenKind) -> i64 {
        match kind {
            token.TokenKind::Star => { return 8; },
            token.TokenKind::Slash => { return 8; },
            token.TokenKind::Percent => { return 8; },
            token.TokenKind::As => { return 7; },
            token.TokenKind::Plus => { return 6; },
            token.TokenKind::Minus => { return 6; },
            token.TokenKind::Caret => { return 5; },
            token.TokenKind::Gt => { return 4; },
            token.TokenKind::Lt => { return 4; },
            token.TokenKind::GtEq => { return 4; },
            token.TokenKind::LtEq => { return 4; },
            token.TokenKind::EqEq => { return 4; },
            token.TokenKind::NotEq => { return 4; },
            token.TokenKind::Inside => { return 4; },
            token.TokenKind::And => { return 3; },
            token.TokenKind::Or => { return 2; },
            token.TokenKind::Pipeline => { return 1; },
            _ => { return 0; },
        }
        return 0;
    }

    pub fn parse_type_name(mut self) -> String {
        let tk = self.advance();
        match tk.kind {
            token.TokenKind::Identifier(val) => { return val; },
            _ => { return "UnknownType"; }
        }
    }

    pub fn parse_infix(mut self, precedence: i64) -> result.Result<ast.Expression, String> {
        let left_res = self.parse_primary();
        if left_res.is_err() {
            return left_res;
        }
        let mut left = left_res.unwrap();
        
        let mut loop_condition = true;
        while loop_condition {
            let tk = self.peek();
            
            let mut is_eof = false;
            match tk.kind {
                token.TokenKind::EOF => { is_eof = true; },
                _ => { is_eof = false; },
            }
            if is_eof {
                loop_condition = false;
            } else {
                let op_prec = self.get_precedence(tk.kind);
                if op_prec <= precedence {
                    loop_condition = false;
                } else {
                    let op = self.advance();
                    
                    let right_res = self.parse_infix(op_prec);
                    if right_res.is_err() {
                        return right_res;
                    }
                    let right = right_res.unwrap();
                    
                    left = ast.Expression::Infix(left, op, right);
                }
            }
        }
        
        return result.Result::Ok(left);
    }

    pub fn parse_expression(mut self) -> result.Result<ast.Expression, String> {
        return self.parse_infix(0);
    }

    pub fn parse_primary(mut self) -> result.Result<ast.Expression, String> {
        let tk = self.advance();
        match tk.kind {
            token.TokenKind::IntLiteral(val) => {
                return result.Result::Ok(ast.Expression::Integer(val));
            },
            token.TokenKind::FloatLiteral(val) => {
                return result.Result::Ok(ast.Expression::Float(val));
            },
            token.TokenKind::StringLiteral(val) => {
                return result.Result::Ok(ast.Expression::StringLit(val));
            },
            token.TokenKind::Identifier(val) => {
                return result.Result::Ok(ast.Expression::Identifier(val));
            },
            token.TokenKind::SelfToken => {
                return result.Result::Ok(ast.Expression::Identifier("self"));
            },
            token.TokenKind::DurationLiteral(secs, nanos) => {
                return result.Result::Ok(ast.Expression::DurationLit(secs, nanos));
            },
            token.TokenKind::DateLiteral(ts) => {
                return result.Result::Ok(ast.Expression::DateLit(ts));
            },
            token.TokenKind::True => {
                return result.Result::Ok(ast.Expression::Boolean(true));
            },
            token.TokenKind::False => {
                return result.Result::Ok(ast.Expression::Boolean(false));
            },
            token.TokenKind::LParen => {
                let expr_res = self.parse_expression();
                if expr_res.is_err() {
                    return expr_res;
                }
                
                let next_tk = self.peek();
                let mut is_rparen = false;
                match next_tk.kind {
                    token.TokenKind::RParen => { is_rparen = true; },
                    _ => { is_rparen = false; }
                }
                
                if is_rparen {
                    self.advance();
                    return expr_res;
                } else {
                    return result.Result::Err("Expected ')' after expression");
                }
            },
            _ => {
                return result.Result::Err("Expected expression in parse_primary");
            }
        }
    }

    pub fn parse_block(mut self) -> result.Result<vector.Vector<ast.Statement>, String> {
        let mut stmts = vector.Vector<ast.Statement>.new();
        
        let tk = self.peek();
        let mut is_lbrace = false;
        match tk.kind {
            token.TokenKind::LBrace => { is_lbrace = true; },
            _ => { is_lbrace = false; },
        }
        
        if is_lbrace {
            self.advance();
        }
        
        let mut loop_condition = true;
        while loop_condition {
            let next_tk = self.peek();
            
            let mut is_end = false;
            match next_tk.kind {
                token.TokenKind::RBrace => { is_end = true; },
                token.TokenKind::EOF => { is_end = true; },
                _ => { is_end = false; },
            }
            
            if is_end {
                loop_condition = false;
            } else {
                let mut is_semi = false;
                match next_tk.kind {
                    token.TokenKind::Semicolon => { is_semi = true; },
                    _ => { is_semi = false; },
                }
                
                if is_semi {
                    self.advance();
                } else {
                    let stmt_res = self.parse_statement();
                    if stmt_res.is_err() {
                        return result.Result::Err(stmt_res.unwrap_err());
                    }
                    stmts.push(stmt_res.unwrap());
                    
                    let check_semi = self.peek();
                    let mut needs_consume = false;
                    match check_semi.kind {
                        token.TokenKind::Semicolon => { needs_consume = true; },
                        _ => { needs_consume = false; },
                    }
                    if needs_consume {
                        self.advance();
                    }
                }
            }
        }
        
        let end_tk = self.peek();
        let mut consume_end = false;
        match end_tk.kind {
            token.TokenKind::RBrace => { consume_end = true; },
            _ => { consume_end = false; },
        }
        if consume_end {
            self.advance();
        }
        
        return result.Result::Ok(stmts);
    }

    pub fn parse_statement(mut self) -> result.Result<ast.Statement, String> {
        let tk = self.peek();
        
        match tk.kind {
            token.TokenKind::Let => {
                self.advance(); // consume let
                
                let mut is_mut = false;
                let check_mut = self.peek();
                match check_mut.kind {
                    token.TokenKind::Mut => {
                        is_mut = true;
                        self.advance();
                    },
                    _ => {},
                }
                
                let name_tk = self.advance();
                let mut name = "";
                match name_tk.kind {
                    token.TokenKind::Identifier(val) => { name = val; },
                    _ => { return result.Result::Err("Expected identifier after let"); },
                }
                
                let eq_tk = self.peek();
                let mut is_eq = false;
                match eq_tk.kind {
                    token.TokenKind::Eq => { is_eq = true; },
                    _ => { is_eq = false; },
                }
                
                if is_eq {
                    self.advance(); // consume =
                    let val_res = self.parse_expression();
                    if val_res.is_err() { return result.Result::Err(val_res.unwrap_err()); }
                    let val = val_res.unwrap();
                    
                    let check_semi = self.peek();
                    let mut consume_semi = false;
                    match check_semi.kind {
                        token.TokenKind::Semicolon => { consume_semi = true; },
                        _ => { consume_semi = false; },
                    }
                    if consume_semi { self.advance(); }
                    
                    return result.Result::Ok(ast.Statement::Let(name, val, "", is_mut));
                } else {
                    return result.Result::Err("Expected = after let identifier");
                }
            },
            token.TokenKind::Return => {
                self.advance(); // consume return
                
                let next_tk = self.peek();
                let mut is_empty_return = false;
                match next_tk.kind {
                    token.TokenKind::Semicolon => { is_empty_return = true; },
                    token.TokenKind::RBrace => { is_empty_return = true; },
                    _ => { is_empty_return = false; },
                }
                
                if is_empty_return {
                    let check_semi = self.peek();
                    let mut consume_semi = false;
                    match check_semi.kind {
                        token.TokenKind::Semicolon => { consume_semi = true; },
                        _ => { consume_semi = false; },
                    }
                    if consume_semi { self.advance(); }
                    return result.Result::Ok(ast.Statement::Return(ast.Expression::Integer(0), ""));
                } else {
                    let val_res = self.parse_expression();
                    if val_res.is_err() { return result.Result::Err(val_res.unwrap_err()); }
                    let val = val_res.unwrap();
                    
                    let check_semi = self.peek();
                    let mut consume_semi = false;
                    match check_semi.kind {
                        token.TokenKind::Semicolon => { consume_semi = true; },
                        _ => { consume_semi = false; },
                    }
                    if consume_semi { self.advance(); }
                    
                    return result.Result::Ok(ast.Statement::Return(val, ""));
                }
            },
            token.TokenKind::If => {
                self.advance(); // consume if
                
                let cond_res = self.parse_expression();
                if cond_res.is_err() { return result.Result::Err(cond_res.unwrap_err()); }
                let cond = cond_res.unwrap();
                
                let then_res = self.parse_block();
                if then_res.is_err() { return result.Result::Err(then_res.unwrap_err()); }
                let then_branch = then_res.unwrap();
                
                let else_tk = self.peek();
                let mut has_else = false;
                match else_tk.kind {
                    token.TokenKind::Else => { has_else = true; },
                    _ => { has_else = false; },
                }
                
                if has_else {
                    self.advance(); // consume else
                    
                    let next_if = self.peek();
                    let mut is_else_if = false;
                    match next_if.kind {
                        token.TokenKind::If => { is_else_if = true; },
                        _ => { is_else_if = false; },
                    }
                    
                    if is_else_if {
                        let stmt_res = self.parse_statement();
                        if stmt_res.is_err() { return result.Result::Err(stmt_res.unwrap_err()); }
                        let stmt = stmt_res.unwrap();
                        let mut else_branch = vector.Vector<ast.Statement>.new();
                        else_branch.push(stmt);
                        return result.Result::Ok(ast.Statement::If(cond, then_branch, else_branch));
                    } else {
                        let else_res = self.parse_block();
                        if else_res.is_err() { return result.Result::Err(else_res.unwrap_err()); }
                        let else_branch = else_res.unwrap();
                        return result.Result::Ok(ast.Statement::If(cond, then_branch, else_branch));
                    }
                } else {
                    let else_branch = vector.Vector<ast.Statement>.new();
                    return result.Result::Ok(ast.Statement::If(cond, then_branch, else_branch));
                }
            },
            token.TokenKind::While => {
                self.advance(); // consume while
                
                let cond_res = self.parse_expression();
                if cond_res.is_err() { return result.Result::Err(cond_res.unwrap_err()); }
                let cond = cond_res.unwrap();
                
                let body_res = self.parse_block();
                if body_res.is_err() { return result.Result::Err(body_res.unwrap_err()); }
                let body = body_res.unwrap();
                
                return result.Result::Ok(ast.Statement::While(cond, body));
            },
            _ => {
                let expr_res = self.parse_expression();
                if expr_res.is_err() { return result.Result::Err(expr_res.unwrap_err()); }
                let expr = expr_res.unwrap();
                
                let eq_tk = self.peek();
                let mut is_eq = false;
                match eq_tk.kind {
                    token.TokenKind::Eq => { is_eq = true; },
                    _ => { is_eq = false; },
                }
                
                if is_eq {
                    self.advance(); // consume =
                    let val_res = self.parse_expression();
                    if val_res.is_err() { return result.Result::Err(val_res.unwrap_err()); }
                    let val = val_res.unwrap();
                    
                    let check_semi = self.peek();
                    let mut consume_semi = false;
                    match check_semi.kind {
                        token.TokenKind::Semicolon => { consume_semi = true; },
                        _ => { consume_semi = false; },
                    }
                    if consume_semi { self.advance(); }
                    
                    return result.Result::Ok(ast.Statement::Assignment(expr, val));
                } else {
                    let check_semi = self.peek();
                    let mut consume_semi = false;
                    match check_semi.kind {
                        token.TokenKind::Semicolon => { consume_semi = true; },
                        _ => { consume_semi = false; },
                    }
                    if consume_semi { self.advance(); }
                    
                    return result.Result::Ok(ast.Statement::ExpressionStmt(expr));
                }
            }
        }
    }

    pub fn parse_function(mut self) -> result.Result<ast.Function, String> {
        io.println("A");
        self.advance(); // consume fn
        io.println("B");
        
        let name_tk = self.advance();
        let mut name = "";
        match name_tk.kind {
            token.TokenKind::Identifier(val) => { name = val; },
            _ => { return result.Result::Err("Expected identifier after fn"); },
        }
        io.println("C");
        
        let mut params = vector.Vector<ast.Param>.new();
        io.println("C1: Params vector created");
        
        let lparen_tk = self.advance();
        io.println("C2: Advanced for lparen");
        
        let mut is_lparen = false;
        io.println("C3: About to match lparen.kind");
        
        match lparen_tk.kind {
            token.TokenKind::LParen => { is_lparen = true; },
            token.TokenKind::Identifier(v) => { io.print("Got ID instead of (: "); io.println(v); },
            token.TokenKind::RParen => { io.println("Got ) instead of ("); },
            _ => { io.println("Got other instead of ("); is_lparen = false; },
        }
        if !is_lparen { return result.Result::Err("Expected ( after fn name"); }
        io.println("D");
        
        let mut loop_condition = true;
        while loop_condition {
            let next_tk = self.peek();
            let mut is_rparen = false;
            match next_tk.kind {
                token.TokenKind::RParen => { is_rparen = true; },
                token.TokenKind::EOF => { is_rparen = true; },
                _ => { is_rparen = false; },
            }
            if is_rparen {
                loop_condition = false;
            } else {
                let p_name_tk = self.advance();
                let mut p_name = "";
                match p_name_tk.kind {
                    token.TokenKind::Identifier(val) => { p_name = val; },
                    _ => { return result.Result::Err("Expected parameter name"); },
                }
                
                let colon_tk = self.advance();
                let mut is_colon = false;
                match colon_tk.kind {
                    token.TokenKind::Colon => { is_colon = true; },
                    _ => { is_colon = false; },
                }
                if !is_colon { return result.Result::Err("Expected : after parameter name"); }
                
                let p_type = self.parse_type_name();
                
                let p = ast.Param {
                    name: p_name,
                    type_name: p_type,
                };
                params.push(p);
                
                let check_comma = self.peek();
                let mut is_comma = false;
                match check_comma.kind {
                    token.TokenKind::Comma => { is_comma = true; },
                    _ => { is_comma = false; },
                }
                if is_comma { self.advance(); }
            }
        }
        io.println("E");
        
        let rparen_tk = self.advance(); // consume )
        
        let mut return_type = "void";
        let check_arrow = self.peek();
        let mut is_arrow = false;
        match check_arrow.kind {
            token.TokenKind::Arrow => { is_arrow = true; },
            _ => { is_arrow = false; },
        }
        if is_arrow {
            self.advance();
            return_type = self.parse_type_name();
        }
        io.println("F");
        
        let body_res = self.parse_block();
        if body_res.is_err() { return result.Result::Err(body_res.unwrap_err()); }
        let body = body_res.unwrap();
        io.println("G");
        
        let f = ast.Function {
            name: name,
            generic_params: vector.Vector<String>.new(),
            params: params,
            return_type: return_type,
            has_body: true,
            body: body,
            modifiers: vector.Vector<token.Token>.new(),
            attributes: vector.Vector<ast.Attribute>.new(),
        };
        io.println("H");
        
        return result.Result::Ok(f);
    }

    pub fn parse_struct(mut self) -> result.Result<ast.Struct, String> {
        io.println("Struct Start");
        self.advance(); // consume struct
        
        let name_tk = self.advance();
        let mut name = "";
        match name_tk.kind {
            token.TokenKind::Identifier(val) => { name = val; },
            _ => { return result.Result::Err("Expected identifier after struct"); },
        }
        
        let lbrace_tk = self.advance();
        let mut is_lbrace = false;
        match lbrace_tk.kind {
            token.TokenKind::LBrace => { is_lbrace = true; },
            _ => { is_lbrace = false; },
        }
        if !is_lbrace { return result.Result::Err("Expected { after struct name"); }
        
        let mut fields = vector.Vector<ast.Field>.new();
        
        let mut loop_condition = true;
        while loop_condition {
            let tk = self.peek();
            let mut is_end = false;
            match tk.kind {
                token.TokenKind::RBrace => { is_end = true; },
                token.TokenKind::EOF => { is_end = true; },
                _ => { is_end = false; },
            }
            if is_end {
                loop_condition = false;
            } else {
                let f_name_tk = self.advance();
                let mut f_name = "";
                match f_name_tk.kind {
                    token.TokenKind::Identifier(val) => { f_name = val; },
                    _ => { return result.Result::Err("Expected field name"); },
                }
                
                let colon_tk = self.advance();
                let mut is_colon = false;
                match colon_tk.kind {
                    token.TokenKind::Colon => { is_colon = true; },
                    _ => { is_colon = false; },
                }
                if !is_colon { return result.Result::Err("Expected : after field name"); }
                
                let f_type = self.parse_type_name();
                
                let f = ast.Field {
                    name: f_name,
                    type_name: f_type,
                };
                fields.push(f);
                
                let check_comma = self.peek();
                let mut is_comma = false;
                match check_comma.kind {
                    token.TokenKind::Comma => { is_comma = true; },
                    _ => { is_comma = false; },
                }
                if is_comma { self.advance(); }
            }
        }
        
        let rbrace_tk = self.advance(); // consume }
        
        let s = ast.Struct {
            name: name,
            generic_params: vector.Vector<String>.new(),
            fields: fields,
            attributes: vector.Vector<String>.new(),
        };
        
        io.println("Struct Done");
        return result.Result::Ok(s);
    }

    pub fn parse_declaration(mut self) -> result.Result<ast.Declaration, String> {
        io.println("Decl Start");
        let tk = self.peek();
        match tk.kind {
            token.TokenKind::Fn => { io.println("Got Fn"); },
            token.TokenKind::Struct => { io.println("Got Struct"); },
            token.TokenKind::Identifier(v) => { io.print("Got ID: "); io.println(v); },
            token.TokenKind::EOF => { io.println("Got EOF"); },
            _ => { io.println("Got Other Token"); }
        }
        match tk.kind {
            token.TokenKind::Fn => {
                io.println("Is Fn");
                let f_res = self.parse_function();
                if f_res.is_err() { return result.Result::Err(f_res.unwrap_err()); }
                return result.Result::Ok(ast.Declaration::Function(f_res.unwrap()));
            },
            token.TokenKind::Struct => {
                io.println("Is Struct");
                let s_res = self.parse_struct();
                if s_res.is_err() { return result.Result::Err(s_res.unwrap_err()); }
                return result.Result::Ok(ast.Declaration::Struct(s_res.unwrap()));
            },
            _ => {
                return result.Result::Err("Expected declaration");
            }
        }
    }

    pub fn parse_program(mut self) -> result.Result<ast.Program, String> {
        io.println("Prog Start");
        let mut decls = vector.Vector<ast.Declaration>.new();
        
        let mut loop_condition = true;
        while loop_condition {
            io.println("Loop start");
            let tk = self.peek();
            io.println("Peeked");
            let mut is_eof = false;
            match tk.kind {
                token.TokenKind::EOF => { is_eof = true; },
                _ => { is_eof = false; },
            }
            if is_eof {
                io.println("Is EOF");
                loop_condition = false;
            } else {
                io.println("Parsing decl");
                let decl_res = self.parse_declaration();
                io.println("Decl parsed");
                if decl_res.is_err() { return result.Result::Err(decl_res.unwrap_err()); }
                decls.push(decl_res.unwrap());
            }
        }
        
        io.println("Creating Program object");
        let p = ast.Program {
            module_name: "test",
            imports: vector.Vector<ast.Import>.new(),
            declarations: decls,
        };
        
        return result.Result::Ok(p);
    }
}