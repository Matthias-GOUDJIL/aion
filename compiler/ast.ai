module compiler.ast

use std.collections.vector
use compiler.token

pub struct Program {
    module_name: String,
    imports: vector.Vector<Import>,
    declarations: vector.Vector<Declaration>,
}

pub struct Import {
    path: vector.Vector<String>,
    alias: String,
}

pub enum Declaration {
    Function(Function),
    Struct(Struct),
    Enum(Enum),
    Interface(Interface),
    Impl(ImplBlock),
}

pub struct Interface {
    name: String,
    methods: vector.Vector<Function>,
}

pub struct ImplBlock {
    target_name: String,
    generic_params: vector.Vector<String>,
    interface_name: String, // Empty string if None
    functions: vector.Vector<Function>,
}

// In Aion, we might not have tuple types yet, or maybe we do. 
// Looking at src/ast.rs: params is Vec<(String, String)>.
// Let's create a struct for Param and Field
pub struct Param {
    name: String,
    type_name: String,
}

pub struct Field {
    name: String,
    type_name: String,
}

pub struct Attribute {
    name: String,
    value: String,
}

pub struct Function {
    name: String,
    generic_params: vector.Vector<String>,
    params: vector.Vector<Param>,
    return_type: String,
    // body is Option in rust, we can use a boolean or an empty Vector to mean "no body" (for interfaces/externs)
    has_body: bool,
    body: vector.Vector<Statement>,
    modifiers: vector.Vector<Token>,
    attributes: vector.Vector<Attribute>,
}

pub struct Struct {
    name: String,
    generic_params: vector.Vector<String>,
    fields: vector.Vector<Field>,
    attributes: vector.Vector<String>,
}

pub struct Enum {
    name: String,
    generic_params: vector.Vector<String>,
    variants: vector.Vector<EnumVariant>,
}

pub struct EnumVariant {
    name: String,
    data_types: vector.Vector<String>,
}

pub struct MatchArm {
    pattern: String,
    params: vector.Vector<String>,
    body: vector.Vector<Statement>,
}

pub enum Statement {
    Let(String, Expression, String, bool), // name, value, intent, is_mut
    Return(Expression, String), // value, intent
    ExpressionStmt(Expression),
    If(Expression, vector.Vector<Statement>, vector.Vector<Statement>), // condition, then_branch, else_branch (empty if none)
    Assignment(Expression, Expression), // target, value
    While(Expression, vector.Vector<Statement>),
    For(String, Expression, vector.Vector<Statement>), // NOTE: dead variant — the Rust parser never produces it (`src/ast/stmt.rs:41`); `for` loops are not parseable; fixtures use `loop` + `break`
    Spawn(vector.Vector<Statement>),
    Match(Expression, vector.Vector<MatchArm>),
    UnsafeBlock(vector.Vector<Statement>),
    Break,
    Continue,
    NoOp
}

pub struct FieldInit {
    name: String,
    value: Expression,
}

pub enum Expression {
    Integer(i64),
    Float(f64),
    StringLit(String), // Renamed from String to avoid conflict with type String
    DurationLit(u64, u32),
    DateLit(i64),
    Identifier(String),
    Boolean(bool),
    Infix(Expression, Token, Expression), // left, operator, right
    Call(String, vector.Vector<String>, vector.Vector<Expression>), // function, generic_args, arguments
    StructInst(String, vector.Vector<String>, vector.Vector<FieldInit>), // name, generic_args, fields
    Range(Expression, Expression), // start, end
    Block(vector.Vector<Statement>, bool), // statements, is_unsafe
    IfExpr(Expression, vector.Vector<Statement>, vector.Vector<Statement>), // condition, then_branch, else_branch
    Deref(Expression),
    Cast(Expression, String), // expr, target
    Intrinsic(String, vector.Vector<Expression>), // name, arguments
    EnumInst(String, String, vector.Vector<String>, vector.Vector<Expression>), // name, variant, generic_args, arguments
    MemberAccess(Expression, String), // receiver, member
    MethodCall(Expression, String, vector.Vector<String>, vector.Vector<Expression>), // receiver, method, generic_args, arguments
    TypeRef(String, vector.Vector<String>) // name, generic_args
}
