module compiler.ast

use std.collections.vector
use compiler.token

pub struct Program {
    module_name: String,
    imports: Vector<Import>,
    declarations: Vector<Declaration>,
}

pub struct Import {
    path: Vector<String>,
    alias: String,
}

pub enum Declaration {
    Function(Function),
    Struct(Struct),
    Enum(Enum),
    Interface(Interface),
    Impl(ImplBlock),
}

pub struct Interface {
    name: String,
    methods: Vector<Function>,
}

pub struct ImplBlock {
    target_name: String,
    generic_params: Vector<String>,
    interface_name: String, // Empty string if None
    functions: Vector<Function>,
}

// In Aion, we might not have tuple types yet, or maybe we do. 
// Looking at src/ast.rs: params is Vec<(String, String)>.
// Let's create a struct for Param and Field
pub struct Param {
    name: String,
    type_name: String,
}

pub struct Field {
    name: String,
    type_name: String,
}

pub struct Attribute {
    name: String,
    value: String,
}

pub struct Function {
    name: String,
    generic_params: Vector<String>,
    params: Vector<Param>,
    return_type: String,
    // body is Option in rust, we can use a boolean or an empty Vector to mean "no body" (for interfaces/externs)
    has_body: bool,
    body: Vector<Statement>,
    modifiers: Vector<Token>,
    attributes: Vector<Attribute>,
}

pub struct Struct {
    name: String,
    generic_params: Vector<String>,
    fields: Vector<Field>,
    attributes: Vector<String>,
}

pub struct Enum {
    name: String,
    generic_params: Vector<String>,
    variants: Vector<EnumVariant>,
}

pub struct EnumVariant {
    name: String,
    data_types: Vector<String>,
}

pub struct MatchArm {
    pattern: String,
    params: Vector<String>,
    body: Vector<Statement>,
}

pub enum Statement {
    Let(String, Expression, String, bool), // name, value, intent, is_mut
    Return(Expression, String), // value, intent
    ExpressionStmt(Expression),
    If(Expression, Vector<Statement>, Vector<Statement>), // condition, then_branch, else_branch (empty if none)
    Assignment(Expression, Expression), // target, value
    While(Expression, Vector<Statement>),
    For(String, Expression, Vector<Statement>),
    Spawn(Vector<Statement>),
    Match(Expression, Vector<MatchArm>),
    UnsafeBlock(Vector<Statement>),
    NoOp
}

pub struct FieldInit {
    name: String,
    value: Expression,
}

pub enum Expression {
    Integer(i64),
    Float(f64),
    StringLit(String), // Renamed from String to avoid conflict with type String
    DurationLit(u64, u32),
    DateLit(i64),
    Identifier(String),
    Boolean(bool),
    Infix(Expression, Token, Expression), // left, operator, right
    Call(String, Vector<String>, Vector<Expression>), // function, generic_args, arguments
    StructInst(String, Vector<String>, Vector<FieldInit>), // name, generic_args, fields
    Range(Expression, Expression), // start, end
    Block(Vector<Statement>, bool), // statements, is_unsafe
    IfExpr(Expression, Vector<Statement>, Vector<Statement>), // condition, then_branch, else_branch
    Deref(Expression),
    Cast(Expression, String), // expr, target
    Intrinsic(String, Vector<Expression>), // name, arguments
    EnumInst(String, String, Vector<String>, Vector<Expression>), // name, variant, generic_args, arguments
    MemberAccess(Expression, String), // receiver, member
    MethodCall(Expression, String, Vector<String>, Vector<Expression>), // receiver, method, generic_args, arguments
    TypeRef(String, Vector<String>) // name, generic_args
}
