module std.net.websocket

use std.net
use std.string
use std.collections.vector
use std.result

pub struct WebSocket {
    socket: std.net::Socket,
    masked: bool,
}

pub enum Message {
    Text(String),
    Binary(Vector<u8>),
    Ping,
    Pong,
    Close,
}

impl WebSocket {
    pub fn connect(url: String) -> Result<WebSocket, String> {
        // Handshake logic intrinsic
        @intrinsic("ws_connect", url)
    }

    pub fn send(self, msg: Message) {
        @intrinsic("ws_send", self.socket, msg)
    }

    pub fn receive(self) -> Result<Message, String> {
        @intrinsic("ws_recv", self.socket)
    }
}
