module std.option

pub enum Option<T> {
    Some(T),
    None
}

impl Option<T> {
    pub fn is_some(self) -> bool {
        match self {
            Option::Some(_) => return true,
            Option::None => return false,
        }
    }

    pub fn is_none(self) -> bool {
        !self.is_some()
    }

    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Option::Some(v) => return v,
            Option::None => return default,
        }
    }

    pub fn unwrap(self) -> T {
        match self {
            Option::Some(v) => {
                return v
            },
            Option::None => {
                @intrinsic("io_println", "Panic: called Option::unwrap() on a None value")
                @intrinsic("exit", 1)
                return 0 as T
            },
        }
    }

    pub fn expect(self, msg: String) -> T {
        match self {
            Option::Some(v) => v,
            Option::None => {
                @intrinsic("io_println", msg)
                @intrinsic("exit", 1)
                return 0 as T
            },
        }
    }
}
