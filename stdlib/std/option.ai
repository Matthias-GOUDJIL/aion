module std.option

pub enum Option<T> {
    Some(T),
    None
}

impl Option<T> {
    pub fn is_some(self) -> bool {
        match self {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Option::Some(v) => v,
            Option::None => default,
        }
    }

    pub fn unwrap(self) -> T {
        match self {
            Option::Some(v) => v,
            Option::None => {
                // TODO: Proper panic
                @intrinsic("io_println", "Error: called Option::unwrap() on a None value")
                @intrinsic("exit", 1)
                // The compiler might need a return here if it doesn't know exit is terminal
                self.unwrap() // dummy
            },
        }
    }
}
