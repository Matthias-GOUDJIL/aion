module std.fs
use std.result

pub fn read_to_string(path: String) -> Result<String, String> {
    ::intent "Reads the entire contents of a file into a string"
    let content = unsafe { @intrinsic("fs_read_to_string", path) as String };
    let is_null = unsafe { @intrinsic("mem_is_null", content) };
    if is_null {
        return Result::Err("Failed to read file");
    }
    return Result::Ok(content);
}

pub fn write(path: String, content: String) -> i64 {
    ::intent "Writes a string slice into a file. Returns bytes written."
    @intrinsic("fs_write", path, content)
}

pub fn exists(path: String) -> bool {
    ::intent "Checks if a file exists at the given path"
    return @intrinsic("fs_exists", path);
}

pub fn append(path: String, content: String) -> i64 {
    ::intent "Appends content to a file. Returns bytes written."
    return @intrinsic("fs_append", path, content) as i64;
}
