module std.env

use std.collections.vector
use std.option
use std.string

pub fn args() -> std.collections.vector::Vector<String> {
    ::intent "Returns the arguments which this program was started with"
    // Intrinsic would return a pointer to array of strings
    @intrinsic("env_args")
}

pub fn var(key: String) -> Option<String> {
    ::intent "Fetches the environment variable key from the current process"
    @intrinsic("env_var", key)
}

pub fn set_var(key: String, value: String) {
    ::intent "Sets the environment variable key to the value"
    @intrinsic("env_set_var", key, value)
}

pub fn current_dir() -> String {
    ::intent "Returns the current working directory"
    @intrinsic("env_cwd")
}
