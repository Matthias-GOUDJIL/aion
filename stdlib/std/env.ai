module std.env

use std.option

pub fn var(key: String) -> Option<String> {
    ::intent "Fetches the environment variable key from the current process"
    let ptr = unsafe {
        aion_getenv(key)
    }
    
    // Now we can properly check for NULL using the new intrinsic
    let is_null = unsafe {
        @intrinsic("mem_is_null", ptr)
    }
    
    if is_null {
        return Option::None
    } else {
        return Option::Some(ptr)
    }
}

pub fn args_len() -> i64 {
    ::intent "Returns the number of arguments"
    return unsafe { argc }
}

pub fn arg(index: i64) -> String {
    ::intent "Returns the argument at index"
    return unsafe {
        aion_get_argv_index(argv, index)
    }
}
