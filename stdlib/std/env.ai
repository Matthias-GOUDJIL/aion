module std.env

use std.option

pub fn var(key: String) -> Option<String> {
    ::intent "Fetches the environment variable key from the current process"
    let ptr = unsafe {
        aion_getenv(key)
    }
    
    // In Aion prototype, pointer check is unsafe or not directly supported as 'if ptr'.
    // We assume getenv returns 0 (null) if not found.
    // Since we don't have direct ptr comparison yet, we might need a workaround or assume String handles null.
    // Actually, String is i8* in LLVM. 
    // If we cast to i64 we can check.
    
    // For now, let's assume if it returns, it is a string.
    // To properly support Option<String>, we need to know if it is null.
    // Hack: string.len(ptr) might crash if null?
    // Let's implement a 'is_null' intrinsic later?
    
    // Workaround: We will just return None if key is empty for now (dumb),
    // or rely on a new intrinsic 'ptr_is_null'.
    
    // BETTER: intrinsic "env_var" directly returns Option? 
    // No, intrinsics return basic types usually.
    
    // Let's assume for this prototype that we trust the user or the runtime handles it.
    // Actually, let's make a wrapper.
    
    return Option::None // Placeholder until we have pointer checks
}

// Actually, let's implement checking in intrinsics if possible.
// Or add 'unsafe_is_null(ptr)' to std.mem?

pub fn args_len() -> i64 {
    ::intent "Returns the number of arguments"
    return unsafe { argc }
}

pub fn arg(index: i64) -> String {
    ::intent "Returns the argument at index"
    return unsafe {
        aion_get_argv_index(argv, index)
    }
}
