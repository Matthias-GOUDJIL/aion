module std.env

use std.option
use std.collections.vector

pub fn var(key: String) -> Option<String> {
    ::intent "Fetches the environment variable key from the current process"
    let ptr = unsafe {
        aion_getenv(key)
    }
    
    // Now we can properly check for NULL using the new intrinsic
    let is_null = unsafe {
        @intrinsic("mem_is_null", ptr)
    }
    
    if is_null {
        return Option::None
    } else {
        return Option::Some(ptr)
    }
}

pub fn args() -> Vector<String> {
    ::intent "Returns the arguments"
    let len = unsafe { aion_get_argc() }
    let mut v = Vector<String>.new()
    let mut i = 1
    while i < len {
        let s = unsafe { aion_get_argv_index(i) }
        v.push(s)
        i = i + 1
    }
    v
}
