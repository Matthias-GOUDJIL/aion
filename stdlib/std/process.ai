module std.process

use std.collections.vector
use std.string
use std.result

pub struct ExitStatus {
    pub code: i64,
}

impl ExitStatus {
    pub fn success(self) -> bool {
        return self.code == 0;
    }
}

pub struct Output {
    pub status: std.process.ExitStatus,
    pub stdout: String,
}

pub struct Command {
    pub program: String,
    pub args: vector.Vector<String>,
}

impl Command {
    pub fn new(program: String) -> Command {
        return std.process.Command {
            program: program,
            args: vector.Vector<String>.new(),
        };
    }

    pub fn arg(mut self, arg: String) -> Command {
        self.args.push(arg);
        return self;
    }

    pub fn build_cmd(self) -> String {
        let mut cmd = self.program;
        let n = (self.args).len();
        let mut i = 0;
        while i < n {
            let a = (self.args).get(i).unwrap();
            cmd = string.concat(cmd, " ");
            cmd = string.concat(cmd, a);
            i = i + 1;
        }
        return cmd;
    }

    pub fn status(self) -> ExitStatus {
        let cmd = self.build_cmd();
        let c = @intrinsic("process_run", cmd);
        return std.process.ExitStatus { code: c };
    }

    pub fn output(self) -> Output {
        let cmd = self.build_cmd();
        let out = @intrinsic("process_output", cmd);
        let st = std.process.ExitStatus { code: 0 };
        return std.process.Output { status: st, stdout: out };
    }
}

pub fn run(cmd: String) -> i64 {
    return @intrinsic("process_run", cmd);
}

pub fn output(cmd: String) -> String {
    return @intrinsic("process_output", cmd);
}
