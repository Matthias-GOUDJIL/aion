module std.collections.set

use std.collections.map
use std.string

pub struct HashSet {
    map: std.collections.map::HashMap<bool>,
}

impl HashSet {
    pub fn new() -> HashSet {
        HashSet {
            map: std.collections.map::HashMap::new(),
        }
    }

    pub fn insert(mut self, value: String) -> bool {
        if self.contains(value) {
            return false;
        }
        self.map.insert(value, true);
        true
    }

    pub fn contains(self, value: String) -> bool {
        std.option::Option::is_some(self.map.get(value))
    }

    pub fn remove(mut self, value: String) -> bool {
        // HashMap needs a remove method ideally, for now this is partial
        // self.map.remove(value) 
        false
    }
}
