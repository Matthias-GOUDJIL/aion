module std.collections.map

use core.memory
use core.heap
use std.collections.vector
use std.hash
use std.option
use std.string

struct Entry<V> {
    key: String,
    value: V,
    next: *Entry<V>,
}

pub struct HashMap<V> {
    buckets: * *Entry<V>,
    len: i64,
    cap: i64,
}

impl HashMap<V> {
    pub fn new() -> HashMap<V> {
        let cap = 16;
        let buckets = unsafe { core.heap.alloc(cap * 8) as * *Entry<V> };
        // Initialize buckets to null
        let mut i = 0;
        while i < cap {
            unsafe {
                let p = buckets.offset(i);
                *p = core.heap.null() as *Entry<V>;
            }
            i = i + 1;
        }
        
        HashMap<V> {
            buckets: buckets,
            len: 0,
            cap: cap,
        }
    }

    pub fn insert(mut self, key: String, value: V) {
        if self.len > self.cap { // Load factor > 1.0 (simplified)
            self.resize();
        }
        
        let h = std.hash.hash_string(key);
        let idx = (h % (self.cap as u64)) as i64;
        
        unsafe {
            let bucket_ptr = self.buckets.offset(idx);
            let mut current = *bucket_ptr;
            
            // Update existing
            while current != (core.heap.null() as *Entry<V>) {
                if std.string.equals((*current).key, key) {
                    (*current).value = value;
                    return;
                }
                current = (*current).next;
            }
            
            // Insert new
            let new_entry = core.heap.alloc(@sizeof(Entry<V>)) as *Entry<V>;
            (*new_entry).key = key;
            (*new_entry).value = value;
            (*new_entry).next = *bucket_ptr;
            *bucket_ptr = new_entry;
        }
        self.len = self.len + 1;
    }

    pub fn get(self, key: String) -> Option<V> {
        let h = std.hash.hash_string(key);
        let idx = (h % (self.cap as u64)) as i64;
        
        unsafe {
            let mut current = *self.buckets.offset(idx);
            while current != (core.heap.null() as *Entry<V>) {
                if std.string.equals((*current).key, key) {
                    return Option::Some((*current).value);
                }
                current = (*current).next;
            }
        }
        Option::None
    }

    pub fn len(self) -> i64 {
        self.len
    }

    pub fn remove(mut self, key: String) -> bool {
        let h = std.hash.hash_string(key);
        let idx = (h % (self.cap as u64)) as i64;
        
        unsafe {
            let bucket_ptr = self.buckets.offset(idx);
            let mut current = *bucket_ptr;
            let mut prev = core.heap.null() as *Entry<V>;
            
            while current != (core.heap.null() as *Entry<V>) {
                if std.string.equals((*current).key, key) {
                    if prev == (core.heap.null() as *Entry<V>) {
                        *bucket_ptr = (*current).next;
                    } else {
                        (*prev).next = (*current).next;
                    }
                    core.heap.dealloc(current as *u8);
                    self.len = self.len - 1;
                    return true;
                }
                prev = current;
                current = (*current).next;
            }
        }
        false
    }
    
    fn resize(mut self) {
        let old_cap = self.cap;
        let new_cap = old_cap * 2;
        let old_buckets = self.buckets;
        
        let new_buckets = unsafe { core.heap.alloc(new_cap * 8) as * *Entry<V> };
        let mut i = 0;
        while i < new_cap {
            unsafe {
                let p = new_buckets.offset(i);
                *p = core.heap.null() as *Entry<V>;
            }
            i = i + 1;
        }
        
        // Rehash
        i = 0;
        while i < old_cap {
            unsafe {
                let mut current = *old_buckets.offset(i);
                while current != (core.heap.null() as *Entry<V>) {
                    let next = (*current).next;
                    
                    // Find new bucket
                    let h = std.hash.hash_string((*current).key);
                    let new_idx = (h % (new_cap as u64)) as i64;
                    let new_bucket_ptr = new_buckets.offset(new_idx);
                    
                    // Insert into new bucket
                    (*current).next = *new_bucket_ptr;
                    *new_bucket_ptr = current;
                    
                    current = next;
                }
            }
            i = i + 1;
        }
        
        unsafe { core.heap.dealloc(old_buckets as *u8); }
        self.buckets = new_buckets;
        self.cap = new_cap;
    }
}
