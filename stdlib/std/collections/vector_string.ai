module std.collections.vector_string

use core.memory
use core.heap
use std.option

pub struct VectorString {
    ptr: *String,
    len: i64,
    cap: i64,
}

impl VectorString {
    pub fn new() -> VectorString {
        VectorString {
            ptr: core.heap.null() as *String,
            len: 0,
            cap: 0,
        }
    }

    pub fn push(mut self, value: String) {
        if self.len == self.cap {
            self.grow();
        }
        unsafe {
            let ptr = self.ptr;
            let offset_ptr = ptr.offset(self.len);
            *offset_ptr = value;
        }
        self.len = self.len + 1;
    }

    pub fn pop(mut self) -> Option<String> {
        if self.len == 0 {
            return Option::None;
        }
        self.len = self.len - 1;
        unsafe {
            let ptr = self.ptr;
            let offset_ptr = ptr.offset(self.len);
            return Option::Some(*offset_ptr);
        }
    }

    pub fn get(self, index: i64) -> Option<String> {
        if index >= self.len {
            return Option::None;
        }
        unsafe {
            let ptr = self.ptr;
            let offset_ptr = ptr.offset(index);
            return Option::Some(*offset_ptr);
        }
    }

    pub fn len(self) -> i64 {
        return self.len;
    }

    fn grow(mut self) {
        let new_cap = if self.cap == 0 { 4 } else { self.cap * 2 };
        let byte_size = new_cap * @sizeof(String);
        let new_ptr_u8 = if self.cap == 0 {
            core.heap.alloc(byte_size)
        } else {
            core.heap.realloc(self.ptr as *u8, byte_size)
        };
        
        self.ptr = new_ptr_u8 as *String;
        self.cap = new_cap;
    }
}
