module std.result

pub enum Result<T, E> {
    Ok(T),
    Err(E)
}

impl Result<T, E> {
    pub fn is_ok(self) -> bool {
        match self {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        }
    }

    pub fn is_err(self) -> bool {
        !self.is_ok()
    }

    pub fn unwrap(self) -> T {
        match self {
            Result::Ok(val) => val,
            Result::Err(_) => {
                @intrinsic("io_println", "Panic: called Result::unwrap() on an Err value")
                @intrinsic("exit", 1)
                return 0 as T
            }
        }
    }

    pub fn unwrap_err(self) -> E {
        match self {
            Result::Err(err) => err,
            Result::Ok(_) => {
                @intrinsic("io_println", "Panic: called Result::unwrap_err() on an Ok value")
                @intrinsic("exit", 1)
                return 0 as E
            }
        }
    }

    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Result::Ok(val) => val,
            Result::Err(_) => default,
        }
    }

    pub fn expect(self, msg: String) -> T {
        match self {
            Result::Ok(val) => val,
            Result::Err(_) => {
                @intrinsic("io_println", msg)
                @intrinsic("exit", 1)
                return 0 as T
            }
        }
    }
}
