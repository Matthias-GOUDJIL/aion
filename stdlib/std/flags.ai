module std.flags

use std.string
use std.collections.ordered_map
use std.collections.vector
use std.env
use std.option

pub struct FlagParser {
    pub flags: ordered_map.OrderedMap<String>,
    pub values: ordered_map.OrderedMap<String>,
    pub bools: ordered_map.OrderedMap<bool>,
    pub positionals: vector.Vector<String>,
}

impl FlagParser {
    pub fn new() -> FlagParser {
        return std.flags.FlagParser {
            flags: ordered_map.OrderedMap<String>.new(),
            values: ordered_map.OrderedMap<String>.new(),
            bools: ordered_map.OrderedMap<bool>.new(),
            positionals: vector.Vector<String>.new(),
        };
    }

    pub fn string(mut self, name: String, default_val: String, usage: String) {
        self.flags.insert(name, usage);
        self.values.insert(name, default_val);
    }

    pub fn bool_flag(mut self, name: String, default_val: bool, usage: String) {
        self.flags.insert(name, usage);
        self.bools.insert(name, default_val);
    }

    pub fn parse_from(mut self, args: vector.Vector<String>) {
        let n = args.len();
        let mut i = 0;
        while i < n {
            let arg = args.get(i).unwrap();
            if string.starts_with(arg, "--") && string.len(arg) > 2 {
                let rest = string.substr(arg, 2, string.len(arg) - 2);
                let eq_idx = string.find(rest, "=");
                if eq_idx > 0 {
                    let key = string.substr(rest, 0, eq_idx);
                    let val = string.substr(rest, eq_idx + 1, string.len(rest) - eq_idx - 1);
                    self.values.insert(key, val);
                    i = i + 1;
                } else if self.bools.contains_key(rest) {
                    self.bools.insert(rest, true);
                    i = i + 1;
                } else if i + 1 < n {
                    let next_arg = args.get(i + 1).unwrap();
                    if !string.starts_with(next_arg, "--") {
                        self.values.insert(rest, next_arg);
                        i = i + 2;
                    } else {
                        self.bools.insert(rest, true);
                        i = i + 1;
                    }
                } else {
                    self.bools.insert(rest, true);
                    i = i + 1;
                }
            } else {
                self.positionals.push(arg);
                i = i + 1;
            }
        }
    }

    pub fn parse(mut self) {
        let args = env.args();
        self.parse_from(args);
    }

    pub fn get_string(self, name: String) -> String {
        match self.values.get(name) {
            option.Option::Some(v) => return v,
            option.Option::None => return "",
        }
    }

    pub fn get_bool(self, name: String) -> bool {
        match self.bools.get(name) {
            option.Option::Some(b) => return b,
            option.Option::None => return false,
        }
    }

    pub fn positional_count(self) -> i64 {
        return (self.positionals).len();
    }

    pub fn positional(self, idx: i64) -> option.Option<String> {
        return (self.positionals).get(idx);
    }
}
