module std.path

use std.string

pub struct Path {
    inner: String,
}

impl Path {
    pub fn new(s: String) -> Path {
        return Path { inner: s };
    }

    pub fn to_string(self) -> String {
        return self.inner;
    }

    pub fn join(self, other: String) -> Path {
        let sep = "/"; 
        return Path { inner: self.inner + sep + other };
    }

    pub fn exists(self) -> bool {
        return @intrinsic("fs_exists", self.inner);
    }

    pub fn extension(self) -> String {
        let s = self.inner;
        let len = string.len(s);
        let mut i = len - 1;
        let mut found = false;
        while i >= 0 {
            if found == false {
                let c = @intrinsic("str_at", s, i);
                if c == 46 { // '.'
                    return @intrinsic("str_substr", s, i + 1, len - i - 1);
                }
                if c == 47 { // '/'
                    found = true;
                }
            }
            i = i - 1;
        }
        return "";
    }

    pub fn filename(self) -> String {
        let s = self.inner;
        let len = string.len(s);
        let mut i = len - 1;
        while i >= 0 {
            let c = @intrinsic("str_at", s, i);
            if c == 47 { // '/'
                return @intrinsic("str_substr", s, i + 1, len - i - 1);
            }
            i = i - 1;
        }
        return s;
    }
}
