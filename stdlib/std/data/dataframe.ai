module std.data.dataframe

use std.string
use std.collections.vector
use std.collections.map
use std.data.series
use std.option
use std.io

pub struct Shape {
    rows: i64,
    cols: i64,
}

pub struct DataFrame {
    columns: HashMap<Series>,
    column_names: Vector<String>, // Keep track of order
}

impl DataFrame {
    pub fn new() -> DataFrame {
        DataFrame {
            columns: HashMap<Series>.new(),
            column_names: Vector<String>.new(),
        }
    }

    pub fn add_column(mut self, s: Series) {
        let name = s.name();
        self.column_names.push(name);
        self.columns.insert(name, s);
    }

    pub fn get_column(self, name: String) -> Option<Series> {
        return self.columns.get(name);
    }

    pub fn shape(self) -> Shape {
        let cols = self.column_names.len();
        if cols == 0 {
            return Shape { rows: 0, cols: 0 };
        }
        
        let first_col_name = self.column_names.get(0).unwrap();
        let first_col = self.columns.get(first_col_name).unwrap();
        return Shape { rows: first_col.len(), cols: cols };
    }

    pub fn describe(self) {
        io.println("DataFrame Summary:");
        let s = self.shape();
        io.print("Rows: "); io.println(s.rows);
        io.print("Cols: "); io.println(s.cols);
        
        let mut i = 0;
        while i < s.cols {
            let name = self.column_names.get(i).unwrap();
            io.print("- "); io.println(name);
            i = i + 1;
        }
    }
}
