module std.sql

use std.string
use std.collections.vector
use std.result
use std.option

// Abstract interface for a DB Driver
pub interface Driver {
    fn connect(connection_string: String) -> Result<Connection, String>;
}

pub interface Connection {
    fn query(query: String, params: Vector<Value>) -> Result<Rows, String>;
    fn execute(query: String, params: Vector<Value>) -> Result<i64, String>; // returns affected rows
    fn close();
}

pub interface Rows {
    fn next() -> bool;
    fn scan(dest: Vector<Value>) -> Result<(), String>;
    fn close();
}

pub enum Value {
    Null,
    Integer(i64),
    Float(f64),
    Text(String),
    Blob(Vector<u8>),
    Bool(bool),
}

