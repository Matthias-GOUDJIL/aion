module std.os

pub fn exit(code: i64) {
    ::intent "Terminates the current process with the specified exit code"
    @intrinsic("os_exit", code)
}

pub fn cpu_count() -> i64 {
    ::intent "Returns the number of logical CPUs available"
    return @intrinsic("os_cpu_count");
}

pub fn name() -> String {
    ::intent "Returns the operating system name (linux, macos, windows)"
    return @intrinsic("os_name");
}
