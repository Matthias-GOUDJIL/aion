module core.heap

::intent "Allocate raw memory on the heap"
@intrinsic("libc.malloc")
pub unsafe fn alloc(size: usize) -> *u8

::intent "Release raw memory back to the system"
@intrinsic("libc.free")
pub unsafe fn dealloc(ptr: *u8)

::intent "Reallocate memory block with new size"
@intrinsic("libc.realloc")
pub unsafe fn realloc(ptr: *u8, new_size: usize) -> *u8
